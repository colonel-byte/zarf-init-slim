{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  assignees: [
    "@A1994SC"
  ],
  baseBranchPatterns: [
    "main"
  ],
  packageRules: [
    {
      // the zarf CLI, the agent image and the imported component configs are all
      // released together and must move together
      matchDatasources: [
        "docker",
        "github-releases"
      ],
      addLabels: [
        "renovate/oci"
      ],
      groupName: "Zarf packages",
      matchPackageNames: [
        "ghcr.io/zarf-dev/components/init/**",
        "ghcr.io/zarf-dev/zarf/agent",
        "zarf-dev/zarf"
      ]
    },
    {
      // the gitea tag carries a "-rootless" suffix, which semver would read as
      // a prerelease; match it explicitly so updates keep flowing
      matchDatasources: [
        "docker"
      ],
      matchPackageNames: [
        "ghcr.io/go-gitea/gitea"
      ],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-rootless$"
    },
  ],
  separateMajorMinor: false,
  "github-actions": {
    enabled: true
  },
  dependencyDashboard: true,
  customManagers: [
    {
      customType: "regex",
      description: [
        "Process custom dependencies"
      ],
      managerFilePatterns: [
        "/(^|/).+\\.ya?ml(\\.j2)?$/"
      ],
      matchStrings: [
        "(?m:# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\n.+?(?<currentValue>v?(?:[0-9]+\\.?){3,4}(?:-.+)?)[\\'\"]?$)",
        "(?m:# renovate: datasource=(?<datasource>\\S+)\n.+: (?:oci:/{2})?(?<depName>[a-z0-9\\.].+):(?<currentValue>v?([0-9]+\\.?){3}(-.+)?$))"
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}"
    },
  ],
}
